NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Comma-separated browser origins allowed for WebSocket upgrades (optional).
RUSTDESK_ALLOWED_ORIGINS=
# Leave empty for local development. Set a private token for a public gateway.
RUSTDESK_GATEWAY_TOKEN=

# Opt in only after preparing a WebRTC-capable ID server.
RUSTDESK_ENABLE_WEBRTC=false
