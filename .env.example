# Port for the Express gateway. Defaults to 3001 when unset.
# yarn dev proxies the web app's /api requests to this port.
PORT=3001

# Listen address. Keep 127.0.0.1 for local development.
# A container sets HOST=0.0.0.0.
HOST=127.0.0.1

# Optional directory of the built web client. Empty keeps the gateway API-only.
WEB_ROOT=

# Required when NODE_ENV=production. Placeholder values are treated as unset.
# Do not commit a real token.
RUSTDESK_GATEWAY_TOKEN=

# Optional comma-separated browser origins. Empty allows the request host and loopback.
RUSTDESK_ALLOWED_ORIGINS=
