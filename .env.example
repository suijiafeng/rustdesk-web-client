NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Comma-separated browser origins allowed for WebSocket upgrades (optional).
RUSTDESK_ALLOWED_ORIGINS=
# Set true to require an Origin header for both WebSocket endpoints.
RUSTDESK_REQUIRE_ORIGIN=false
# Comma-separated proxy IPs/CIDRs allowed to supply client addresses; empty trusts none.
# Example for a proxy on the same host: 127.0.0.1,::1
RUSTDESK_TRUSTED_PROXIES=
# Use cf-connecting-ip only when the trusted ingress overwrites that header.
RUSTDESK_CLIENT_IP_HEADER=x-forwarded-for
# Explicitly enable only for a gateway that is intended to reach LAN targets.
RUSTDESK_ALLOW_PRIVATE_TARGETS=false
# Additional TCP ports for ID and relay servers in production.
RUSTDESK_ALLOWED_TARGET_PORTS=
# Skip the gateway's direct TCP attempt for ID connections; browser WebRTC is independent.
RUSTDESK_DEFAULT_FORCE_RELAY=false
# Leave empty for local development. Set a private token for a public gateway.
RUSTDESK_GATEWAY_TOKEN=

# Opt in only after preparing a WebRTC-capable ID server.
RUSTDESK_ENABLE_WEBRTC=false
