{
  "name": "@rustdesk-web/gateway",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:express --outfile=dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/health.test.ts"
  },
  "dependencies": {
    "express": "4.22.3"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "esbuild": "0.25.12"
  }
}
