{
  "name": "rustdesk-web-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.js",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "proto:types": "tsx build/generateProtoTypes.ts",
    "proto:check": "tsx build/generateProtoTypes.ts --check",
    "test": "node --import tsx --test src/lib/*.test.ts server/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "node tests/runBrowserTests.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "buffer": "^6.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fzstd": "^0.1.1",
    "lucide-react": "^0.546.0",
    "protobufjs": "^8.8.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tweetnacl": "^1.0.3",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.25.0",
    "protobufjs-cli": "^2.7.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "description": "Browser client and Node.js gateway for RustDesk remote desktop sessions.",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "yarn@1.22.22",
  "repository": {
    "type": "git",
    "url": "https://github.com/suijiafeng/rustdesk.git",
    "directory": "web-client"
  }
}
